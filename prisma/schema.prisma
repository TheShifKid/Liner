// Liner's SERVER database: only the shared music catalog.
//
// These tables are a local cache of MusicBrainz (artists, albums, tracks,
// searches). Nobody "owns" these rows; they fill up lazily the first time an
// album is searched or opened, so the app gets faster the more it's used.
//
// Nothing personal is stored here. Your ratings, reviews, history, diary and
// tier lists live in your browser (IndexedDB, see lib/local/db.ts), so the
// server never knows what you think of anything.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ──────────────────────────── catalog ────────────────────────────

model Artist {
  // MusicBrainz IDs (MBIDs) are stable UUIDs, so we use them directly as our
  // primary key instead of inventing our own IDs. This is called a
  // "natural key": the data already comes with a unique identifier.
  mbid           String  @id
  name           String
  sortName       String?
  disambiguation String?
  country        String?
  genres         String? // JSON array; fallback when an album has no genres of its own

  discographyFetchedAt DateTime?

  albums Album[]
}

// An "Album" here is a MusicBrainz *release group*: the abstract album
// ("OK Computer") as opposed to one specific pressing (the 1997 UK CD, the
// 2017 remaster...). People rate release groups, not pressings.
model Album {
  mbid             String   @id
  title            String
  artistCredit     String // display string, e.g. "Simon & Garfunkel"
  primaryType      String? // Album, EP, Single...
  secondaryTypes   String? // JSON array: ["Live", "Compilation"]
  firstReleaseDate String? // MusicBrainz dates can be "1997", "1997-06" or "1997-06-16"
  year             Int?
  genres           String? // JSON array of genre names, most-voted first
  hasCoverArt      Boolean?

  // The specific release we took the tracklist from (see lib/musicbrainz.ts
  // for how it is chosen).
  releaseMbid     String?
  tracksFetchedAt DateTime?
  // Exact links on streaming services, harvested from MusicBrainz "url
  // relationships". JSON like {"spotify": "...", "apple": "..."}; "{}" means
  // we looked and found none (so the UI falls back to a search link).
  streamLinks     String?

  artistMbid String?
  artist     Artist? @relation(fields: [artistMbid], references: [mbid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks Track[]

  @@index([artistMbid])
  @@index([year])
}

model Track {
  id            String  @id @default(cuid())
  albumMbid     String
  recordingMbid String?
  title         String
  position      Int // 1-based, running across discs
  disc          Int     @default(1)
  number        String? // as printed on the sleeve: "A1", "3"...
  lengthMs      Int?

  album Album @relation(fields: [albumMbid], references: [mbid], onDelete: Cascade)

  @@index([albumMbid, position])
}

// Remembers which albums a search returned, so repeating a search costs zero
// MusicBrainz calls. Stale after a week (new releases appear).
model SearchCache {
  query       String   @id
  albumMbids  String // JSON array, in result order
  artistMbids String   @default("[]")
  fetchedAt   DateTime @default(now())
}
